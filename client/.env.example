# Local development defaults to the Cloudflare API Worker on port 8787 via the Vite proxy.
# To use the FastAPI fallback instead:
# API_PROXY_TARGET=http://127.0.0.1:8000
#
# Production: backend origin only, no trailing /api. Requests go to ${VITE_API_URL}/api/...
# Leave unset to use same-origin /api (Worker service binding).
# VITE_API_URL=https://kenya-quest-server.onrender.com
